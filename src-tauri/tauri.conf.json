{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnapHost",
  "version": "0.1.0",
  "identifier": "com.snaphost.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SnapHost — Ultra-Fast Hosts Switcher",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
